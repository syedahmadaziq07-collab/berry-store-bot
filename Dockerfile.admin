FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run lint && npm test && npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-admin.txt ./
RUN pip install --no-cache-dir -r requirements-admin.txt && useradd --uid 10001 --create-home berry
COPY admin_app.py provider_readiness.py video_reconciliation.py ./
COPY ai_model_mapping.py ./
COPY ai_model_mapping_store.py ./
COPY ai_job_service.py staging_job_worker.py fal_provider.py berry_credit_pricing.py ai_wallet_pricing_adapter.py ai_wallet_quote_check.py telegram_wallet_bridge.py ./
COPY topup_checkout.py staging_recovery_batch.py ./
COPY video_myr_worker.py telegram_video_flow.py telegram_video_handlers.py telegram_video_delivery.py ./
COPY step2_no_retry_protocol.py step2_submission_gate.py ./
RUN python -m py_compile step2_no_retry_protocol.py step2_submission_gate.py
RUN python -m py_compile ai_job_service.py staging_job_worker.py fal_provider.py berry_credit_pricing.py ai_wallet_pricing_adapter.py ai_wallet_quote_check.py telegram_wallet_bridge.py topup_checkout.py staging_recovery_batch.py video_myr_worker.py telegram_video_flow.py telegram_video_handlers.py telegram_video_delivery.py
COPY --from=frontend /build/dist/ ./frontend/dist/
USER berry
EXPOSE 10000
CMD ["sh", "-c", "exec gunicorn --workers 1 --threads 4 --timeout 120 --bind 0.0.0.0:${PORT:-10000} 'admin_app:create_app()'"]
